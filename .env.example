# Copie para .env.development (ou .env.<ambiente>) e preencha os valores.
# O env.ts carrega .env.${NODE_ENV} e valida tudo no boot.

NODE_ENV=development
PORT=8000
LOG_LEVEL=debug

# Postgres — porta do host conforme docker-compose (5434 mapeia p/ 5432 no container)
DATABASE_URL=postgresql://user:password@localhost:5434/homehub?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT — gere segredos fortes fora de dev (ex.: openssl rand -base64 32)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
